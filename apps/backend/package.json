{
  "name": "@zaaz/backend",
  "version": "1.0.1",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node ./dist/index.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
    "prettier:fix": "npx prettier --write src",
    "prepare": "husky install",
    "test": "jest",
    "test:watch": "jest --watch",
    "docker:dev": "TARGET=development NODE_ENV=development docker compose -f ../../infra/docker/docker-compose.yml --profile dev up -d --build",
    "docker:dev:stop": "TARGET=development NODE_ENV=development docker compose -f ../../infra/docker/docker-compose.yml --profile dev down",
    "docker:dev:logs": "TARGET=development NODE_ENV=development docker compose -f ../../infra/docker/docker-compose.yml --profile dev logs -f",
    "docker:dev:shell": "docker exec -it main-server-app sh",
    "docker:dev:restart": "npm run docker:dev:stop && npm run docker:dev",
    "docker:prod": "TARGET=production NODE_ENV=production DOCKER_CMD='pnpm start' docker compose -f ../../infra/docker/docker-compose.yml up -d --build",
    "docker:prod:stop": "TARGET=production NODE_ENV=production docker compose -f ../../infra/docker/docker-compose.yml down",
    "docker:prod:logs": "TARGET=production NODE_ENV=production docker compose -f ../../infra/docker/docker-compose.yml logs -f",
    "docker:prod:shell": "docker exec -it main-server-app sh",
    "docker:prod:restart": "npm run docker:prod:stop && npm run docker:prod",
    "docker:compose:up": "docker-compose -f ../../infra/docker/docker-compose.yml up -d --build",
    "docker:compose:down": "docker-compose -f ../../infra/docker/docker-compose.yml down",
    "docker:compose:logs": "docker-compose -f ../../infra/docker/docker-compose.yml logs -f",
    "kafka:up": "docker-compose -f ../../infra/docker/docker-compose.kafka.yml up -d",
    "kafka:down": "docker-compose -f ../../infra/docker/docker-compose.kafka.yml down",
    "kafka:logs": "docker-compose -f ../../infra/docker/docker-compose.kafka.yml logs -f",
    "kafka:restart": "npm run kafka:down && npm run kafka:up",
    "rabbitmq:up": "docker-compose -f ../../infra/docker/docker-compose.rabbitmq.yml up -d",
    "rabbitmq:down": "docker-compose -f ../../infra/docker/docker-compose.rabbitmq.yml down",
    "rabbitmq:logs": "docker-compose -f ../../infra/docker/docker-compose.rabbitmq.yml logs -f",
    "dev:up": "docker-compose -f ../../infra/docker/docker-compose.dev.yml up -d",
    "dev:down": "docker-compose -f ../../infra/docker/docker-compose.dev.yml down",
    "dev:logs": "docker-compose -f ../../infra/docker/docker-compose.dev.yml logs -f",
    "prod:up": "docker-compose -f ../../infra/docker/docker-compose.prod.yml up -d",
    "prod:down": "docker-compose -f ../../infra/docker/docker-compose.prod.yml down",
    "prod:logs": "docker-compose -f ../../infra/docker/docker-compose.prod.yml logs -f"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "@sendgrid/mail": "^8.1.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "@vercel/node": "^5.10.2",
    "amqplib": "^0.10.9",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "flattener-kit": "^1.0.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "lru-cache": "^11.5.2",
    "mime-types": "^3.0.2",
    "mongo-sanitize": "^1.1.0",
    "mongodb": "^6.21.0",
    "mongoose": "^8.24.4",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^7.0.13",
    "opossum": "^9.0.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^9.1.1",
    "redis": "^5.12.1",
    "resend": "^6.28.1",
    "socket.io": "^4.8.3",
    "stripe": "^19.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/http-status": "^1.1.2",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/kafkajs": "^1.9.0",
    "@types/mime-types": "^3.0.1",
    "@types/mongo-sanitize": "^1.0.3",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.13.5",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.24",
    "@types/opossum": "^8.1.9",
    "@types/supertest": "^7.2.1",
    "@types/yargs": "^17.0.35",
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "prettier": "^3.9.7",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
